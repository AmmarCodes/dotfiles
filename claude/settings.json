{
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "ralph-loop@anthropic-plugin-directory": true,
    "context-mode@context-mode": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "feedbackSurveyRate": 0,
  "prefersReducedMotion": true,
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
